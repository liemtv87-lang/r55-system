# Shared routes for original UI, read-only snapshots and native API.
(r55routes) {
  encode zstd gzip
  @health path /_kq247/health
  respond @health "KQ247 R55 VPS running" 200

  handle /_kq247/cache-health {
    rewrite * /healthz
    reverse_proxy football-cache:3000
  }
  handle /_kq247/native-health {
    rewrite * /healthz
    reverse_proxy football-native:3001
  }
  # Original unchanged UI uses ?data=1; preserve the existing native API
  # for integrations that do not send that query flag.
  @original_main {
    path /api/main-football
    query data=1
  }
  handle /api/main-football {
    route {
      reverse_proxy @original_main football-original:3002
      reverse_proxy football-native:3001
    }
  }
  handle /api/health {
    reverse_proxy football-native:3001
  }
  @lottery_paths {
    path /xoso /xoso/ /xoso-khach /xoso-khach/ /lottery/*
  }
  handle @lottery_paths {
    reverse_proxy lottery-original:3004
  }
  handle {
    root * /srv
    file_server
  }
}

:18080 {
  import r55routes
}

# Public HTTPS name resolves directly to this VPS's IPv4 address.
64-120-92-172.sslip.io {
  import r55routes
}

# A visitor who opens the old bare IP automatically reaches the clickable HTTPS site.
http://:80 {
  redir https://64-120-92-172.sslip.io{uri} permanent
}

# Vietlott 32-rule VPS: independent HTTPS host; block remote compute triggers.
vietlott.64-120-92-172.sslip.io {
  encode zstd gzip
  @mutations method POST PUT PATCH DELETE
  respond @mutations 403
  @private_path path /file
  respond @private_path 403
  reverse_proxy kq247-vietlott-vps:8080
}
