# Shared routes for original UI, read-only snapshots and native API.
(r55routes) {
  encode zstd gzip
  @health path /_kq247/health
  respond @health "KQ247 R55 VPS running" 200

  handle /_kq247/cache-health {
    rewrite * /healthz
    reverse_proxy football-cache:3000
  }
  handle /_kq247/native-health {
    rewrite * /healthz
    reverse_proxy football-native:3001
  }
  # PayOS callbacks are verified and processed exclusively by the sales bot.
  # Do not proxy arbitrary sales admin or internal health endpoints.
  @payos_callback path /payos/webhook /payos/return /payos/cancel
  handle @payos_callback {
    reverse_proxy kq247-sales-bot-primary:3032
  }

  # Original unchanged UI uses ?data=1; preserve the existing native API
  # for integrations that do not send that query flag.
  @original_main {
    path /api/main-football
    query data=1
  }
  handle /api/main-football {
    route {
      reverse_proxy @original_main football-original:3002
      reverse_proxy football-native:3001
    }
  }
  handle /api/health {
    reverse_proxy football-native:3001
  }
  # The lottery UI uses root-relative links (?region=xsmt/xsmn).
  # Keep these on the XSMB/XSMT/XSMN primary; preserve station query.
  # Requests without a lottery region still serve the football homepage.
  @lottery_region_root_xsmb {
    path /
    query region=xsmb
  }
  redir @lottery_region_root_xsmb /xoso?{http.request.uri.query} 302
  @lottery_region_root_xsmt {
    path /
    query region=xsmt
  }
  redir @lottery_region_root_xsmt /xoso?{http.request.uri.query} 302
  @lottery_region_root_xsmn {
    path /
    query region=xsmn
  }
  redir @lottery_region_root_xsmn /xoso?{http.request.uri.query} 302

  # XSMB public page reads ONLY immutable PostgreSQL-exported snapshot.
  # XSMT/XSMN remain on existing route until their local archives are migrated.
  @xsmb_page_path {
    path /xoso /xoso/
  }
  @xsmt_page_query {
    query region=xsmt
  }
  @xsmn_page_query {
    query region=xsmn
  }
  # All three XS regions read immutable 36-station VPS snapshot data.
  # Same /xoso and /xoso-khach URLs; licensed customer path unchanged.
  handle @xsmb_page_path {
    reverse_proxy kq247-xs-36-reader:3019
  }
  # Never alter licensed customer activation, existing device codes or other regions.
  @lottery_paths {
    path /xoso-khach /xoso-khach/ /lottery/*
  }
  handle @lottery_paths {
    reverse_proxy lottery-original:3004
  }
  handle {
    root * /srv
    file_server
  }
}

:18080 {
  import r55routes
}

# Public HTTPS name resolves directly to this VPS's IPv4 address.
64-120-92-172.sslip.io {
  import r55routes
}

# A visitor who opens the old bare IP automatically reaches the clickable HTTPS site.
http://:80 {
  redir https://64-120-92-172.sslip.io{uri} permanent
}

# Vietlott 32-rule VPS: independent HTTPS host; block remote compute triggers.
vietlott.64-120-92-172.sslip.io {
  encode zstd gzip
  @mutations method POST PUT PATCH DELETE
  respond @mutations 403
  @private_path path /file
  respond @private_path 403
  reverse_proxy kq247-vietlott-vps:8080
}
